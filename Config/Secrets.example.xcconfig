// Secrets.example.xcconfig
// Skopiuj ten plik jako Config/Secrets.xcconfig i wpisz własny klucz:
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
// Klucz uzyskasz na openrouteservice.org (konto darmowe).
// Uwaga: w plikach .xcconfig "//" rozpoczyna komentarz, dlatego wartości
// nie mogą zawierać adresów URL zapisanych wprost.

ORS_API_KEY = your-openrouteservice-api-key
